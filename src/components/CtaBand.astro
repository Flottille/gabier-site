---
import Button from "./Button.astro";

export interface Props {
  title: string;
  subtitle: string;
  primary: { href: string; label: string; external?: boolean };
  secondary?: { href: string; label: string; external?: boolean };
}

const { title, subtitle, primary, secondary } = Astro.props;
---

<section class="w-full border-t border-line">
  <div class="container-site flex flex-wrap items-center justify-between gap-5 py-14">
    <div class="flex flex-col gap-1.5">
      <p class="m-0 text-2xl font-bold text-ink">{title}</p>
      <p class="m-0 text-[0.9375rem] text-ink-muted">{subtitle}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <Button href={primary.href} variant="primary" external={primary.external}>{primary.label}</Button>
      {
        secondary && (
          <Button href={secondary.href} variant="outline" external={secondary.external}>
            {secondary.label}
          </Button>
        )
      }
    </div>
  </div>
</section>
