---
export interface Props {
  href?: string;
  variant?: "primary" | "outline" | "light";
  size?: "md" | "sm";
  class?: string;
  external?: boolean;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  class: className = "",
  external = false,
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-[0.625rem] font-bold no-underline transition-all duration-150 ease-[var(--ease-out-soft)] active:translate-y-px";

const variants = {
  primary: "bg-brand text-bg hover:bg-brand-soft",
  outline: "border border-line-strong text-ink font-medium hover:border-ink-dim hover:bg-surface",
  light: "bg-ink text-bg hover:bg-white",
} as const;

const sizes = {
  md: "min-h-12 px-[1.375rem] py-[0.875rem] text-base",
  sm: "min-h-11 px-4 py-2.5 text-sm",
} as const;

const Tag = href ? "a" : "button";
const externalAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<Tag
  href={href}
  type={href ? undefined : "button"}
  class:list={[base, variants[variant], sizes[size], className]}
  {...externalAttrs}
  {...rest}
>
  <slot />
</Tag>
