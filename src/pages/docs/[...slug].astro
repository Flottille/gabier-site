---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { docFile, docHref, getSortedDocs } from "../../lib/docs";
import type { Doc } from "../../lib/docs";
import { LINKS } from "../../config/site";
import { breadcrumbsLd, faqLd, techArticleLd } from "../../lib/jsonld";

export async function getStaticPaths() {
  const docs = await getSortedDocs();

  return docs.map((doc, index) => ({
    // `index` is the section landing page and owns `/docs/` itself.
    params: { slug: doc.id === "index" ? undefined : doc.id },
    props: {
      doc,
      docs,
      prev: docs[index - 1],
      next: docs[index + 1],
    },
  }));
}

interface Props {
  doc: Doc;
  docs: Doc[];
  prev?: Doc;
  next?: Doc;
}

const { doc, docs, prev, next } = Astro.props;
const { Content, headings } = await render(doc);

const jsonLd: unknown[] = [
  techArticleLd({
    title: doc.data.title,
    description: doc.data.description,
    path: docHref(doc.id),
    section: doc.data.group,
  }),
  breadcrumbsLd(
    doc.id === "index"
      ? [
          { name: "Home", path: "/" },
          { name: "Docs", path: "/docs/" },
        ]
      : [
          { name: "Home", path: "/" },
          { name: "Docs", path: "/docs/" },
          { name: doc.data.title, path: docHref(doc.id) },
        ],
  ),
];

if (doc.data.faq) {
  jsonLd.push(faqLd(doc.data.faq.map(({ q, a }) => ({ question: q, answer: a }))));
}
---

<DocsLayout
  doc={doc}
  docs={docs}
  headings={headings}
  prev={prev}
  next={next}
  editUrl={LINKS.editDocs(docFile(doc))}
  jsonLd={jsonLd}
>
  <Content />
</DocsLayout>
